# --------------------- INFORMATION --------------------------------

# This the test Makefile for MacOS and the clang compiler.
# It assumes a Unix-like setup for some commands.

# The dtest program itself does not use multi-threading, 
# but the library might, depending on how it was compiled.

# The Makefile also allows an "un-official" and ugly, but
# sometimes practical compilation of a directly integrated
# executable (i.e. not using the DLL).  For this the Makefile
# uses the source and object files in the src directory...
# Use "make itest" at your own risk.

# If you need to add something for the threading system, this is
# the place.

# This is only necessary for the .a static library, actually.

THR_GCD		= -DDDS_THREADS_GCD
THR_STL		= -DDDS_THREADS_STL

THREADING	= $(THR_GCD) $(THR_STL)

HOST_ARCH	:= $(shell uname -m 2>/dev/null)
ifeq ($(HOST_ARCH),arm64)
M1_MAX_BUILD	?=	1
else
M1_MAX_BUILD	?=	0
endif

M1_MAX_FLAGS	=
ifeq ($(M1_MAX_BUILD),1)
M1_MAX_FLAGS	+= -DDDS_TARGET_APPLE_M1_MAX
M1_MAX_ARCH_FLAGS	=	-mcpu=apple-m1 -mtune=apple-m1
M1_MAX_RELEASE_FLAGS	=	-ffast-math -fstrict-aliasing -funroll-loops -fomit-frame-pointer \
		-ffunction-sections -fdata-sections
M1_MAX_LINK_FLAGS	=	-Wl,-dead_strip -Wl,-dead_strip_dylibs
else
M1_MAX_ARCH_FLAGS	=	-mtune=generic
M1_MAX_RELEASE_FLAGS	=
M1_MAX_LINK_FLAGS	=
endif

THREAD_LINK	=

# ----------------------- OFTEN OK    ------------------------------

# From here on you you don't have to change anything to CONFIGURE
# the compilation.  But you may well have to change something to 
# get it to compile.

INCL_DDS_SOURCE	= Makefiles/dds_sources.txt
INCL_OWN_SOURCE	= Makefiles/own_sources.txt

# If your compiler name is not given here, change it.
CC		= clang++

PROFILE_BUILD	?=	0
PGO_MODE	?=	none
PGO_PROFILE_DATA	?=	$(CURDIR)/../src/build-pgo-generate/pgo-data/default.profdata

# We compile with aggressive warnings, but we have to turn off some
# of them as they appear in libraries in great numbers...

WARN_FLAGS	= 		\
	-Wshadow 		\
	-Wsign-conversion 	\
	-pedantic -Wall -Wextra  \
	-Wcast-align -Wcast-qual \
	-Wctor-dtor-privacy 	\
	-Wdisabled-optimization \
	-Winit-self 		\
	-Wmissing-declarations 	\
	-Wmissing-include-dirs 	\
	-Wcomment 		\
	-Wold-style-cast 	\
	-Woverloaded-virtual 	\
	-Wredundant-decls 	\
	-Wsign-promo 		\
	-Wstrict-overflow=1 	\
	-Wswitch-default -Wundef \
	-Werror 		\
	-Wno-unused 		\
	-Wno-unknown-pragmas 	\
	-Wno-long-long		\
	-Wno-format

RELEASE_OPT_FLAGS	= -O3 -flto $(M1_MAX_RELEASE_FLAGS)
PROFILE_OPT_FLAGS	= -O2 -g -fno-omit-frame-pointer

ifeq ($(PROFILE_BUILD),1)
OPT_FLAGS	= $(PROFILE_OPT_FLAGS)
	BASE_BUILD_DIR	= build-profile
	BASE_DDS_BUILD_DIR	= ../src/build-profile
	BASE_RPATH_DIR	= @loader_path/../../src/build-profile
else ifeq ($(PGO_MODE),generate)
OPT_FLAGS	= $(RELEASE_OPT_FLAGS) -fprofile-instr-generate
	BASE_BUILD_DIR	= build-pgo-generate
	BASE_DDS_BUILD_DIR	= ../src/build-pgo-generate
	BASE_RPATH_DIR	= @loader_path/../../src/build-pgo-generate
PGO_LINK_FLAGS	= -fprofile-instr-generate
else ifeq ($(PGO_MODE),use)
	OPT_FLAGS	= $(RELEASE_OPT_FLAGS) -fprofile-instr-use=$(PGO_PROFILE_DATA) -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date
	BASE_BUILD_DIR	= build-pgo-use
	BASE_DDS_BUILD_DIR	= ../src/build-pgo-use
	BASE_RPATH_DIR	= @loader_path/../../src/build-pgo-use
PGO_LINK_FLAGS	= -fprofile-instr-use=$(PGO_PROFILE_DATA)
else
OPT_FLAGS	= $(RELEASE_OPT_FLAGS)
	BASE_BUILD_DIR	= build
	BASE_DDS_BUILD_DIR	= ../src/build
	BASE_RPATH_DIR	= @loader_path/../../src/build
endif

PGO_LINK_FLAGS	?=
BUILD_DIR	?=	$(BASE_BUILD_DIR)
DDS_BUILD_DIR	?=	$(BASE_DDS_BUILD_DIR)
RPATH_DIR	?=	$(BASE_RPATH_DIR)
EXTRA_COMPILE_FLAGS ?=
EXTRA_LINK_FLAGS ?=

COMPILE_FLAGS	= $(OPT_FLAGS) $(M1_MAX_ARCH_FLAGS) \
		$(WARN_FLAGS) -std=c++11 -I../include $(THREADING) $(M1_MAX_FLAGS) $(EXTRA_COMPILE_FLAGS)

.PHONY:	dtest regression_api timer_regression play_analysis_benchmark alpha_mu moves_sort_benchmark itest profile_binaries depend clean

DLLBASE		= dds
STATIC_LIB	= lib$(DLLBASE).a
DLIB 		= $(DLLBASE).lib

OBJ_DIR		= $(BUILD_DIR)/obj

LINK1_FLAGS	=
LINK2_FLAGS	= $(THREAD_LINK) $(PGO_LINK_FLAGS) $(M1_MAX_LINK_FLAGS) $(EXTRA_LINK_FLAGS) \
		-L$(DDS_BUILD_DIR) -l$(DLLBASE) \
		-Wl,-rpath,$(RPATH_DIR)
LINK3_FLAGS	= $(THREAD_LINK) $(PGO_LINK_FLAGS) $(M1_MAX_LINK_FLAGS) $(EXTRA_LINK_FLAGS)

# This is in addition to $(DTEST).cpp

include $(INCL_OWN_SOURCE)

DTEST_OBJ_FILES	= $(addprefix $(OBJ_DIR)/,$(subst .cpp,.o,$(DTEST_SOURCE_FILES))) \
		  $(OBJ_DIR)/$(DTEST).o

REGAPI_SOURCE_FILES	=	\
	compare.cpp		\
	parse.cpp		\
	print.cpp		\
	regression_api.cpp

REGAPI_OBJ_FILES	= $(addprefix $(OBJ_DIR)/,$(subst .cpp,.o,$(REGAPI_SOURCE_FILES)))

TIMERREG_SOURCE_FILES	=	\
	../src/Timer.cpp	\
	timer_regression.cpp

TIMERREG_OBJ_FILES	= $(OBJ_DIR)/src/Timer.o $(OBJ_DIR)/$(TIMERREG).o

PLAYREG_SOURCE_FILES	=	\
	play_analysis_benchmark.cpp

PLAYREG_OBJ_FILES	= $(OBJ_DIR)/$(PLAYREG).o $(OBJ_DIR)/examples/hands.o

ALPHAMU_LOCAL_SOURCE_FILES	=	\
	parse.cpp		\
	alpha_mu_tests.cpp	\
	alpha_mu.cpp

ALPHAMU_PROD_SOURCE_FILES	=	\
	../src/alpha_mu_support.cpp	\
	../src/alpha_mu_front.cpp	\
	../src/alpha_mu_worlds.cpp	\
	../src/alpha_mu_bridge.cpp	\
	../src/alpha_mu_core.cpp	\
	../src/alpha_mu_decision.cpp	\
	../src/alpha_mu_reporting.cpp

ALPHAMU_OBJ_FILES	= $(addprefix $(OBJ_DIR)/,$(subst .cpp,.o,$(ALPHAMU_LOCAL_SOURCE_FILES))) \
	$(addprefix $(OBJ_DIR)/src/,$(patsubst ../src/%.cpp,%.o,$(ALPHAMU_PROD_SOURCE_FILES)))

MOVESORTBENCH_SOURCE_FILES	=	\
	moves_sort_benchmark.cpp

MOVESORTBENCH_OBJ_FILES	= $(addprefix $(OBJ_DIR)/,$(subst .cpp,.o,$(MOVESORTBENCH_SOURCE_FILES)))

DTEST		= dtest
ITEST		= itest
REGAPI		= regression_api
TIMERREG	= timer_regression
PLAYREG		= play_analysis_benchmark
ALPHAMU		= alpha_mu
MOVESORTBENCH	= moves_sort_benchmark

DTEST_BIN	= $(BUILD_DIR)/$(DTEST)
ITEST_BIN	= $(BUILD_DIR)/$(ITEST)
REGAPI_BIN	= $(BUILD_DIR)/$(REGAPI)
TIMERREG_BIN	= $(BUILD_DIR)/$(TIMERREG)
PLAYREG_BIN	= $(BUILD_DIR)/$(PLAYREG)
ALPHAMU_BIN	= $(BUILD_DIR)/$(ALPHAMU)
MOVESORTBENCH_BIN	= $(BUILD_DIR)/$(MOVESORTBENCH)

# These are the files that we steal from the src directory.

include $(INCL_DDS_SOURCE)

ITEST_SOURCE_FILES	=	\
	$(DDS_SOURCE_FILES)	\
	$(DTEST_SOURCE_FILES)	\
	itest.cpp

ITEST_OBJ_FILES	= $(addprefix $(OBJ_DIR)/src/,$(patsubst ../src/%.cpp,%.o,$(DDS_SOURCE_FILES))) \
		  $(addprefix $(OBJ_DIR)/,$(subst .cpp,.o,$(DTEST_SOURCE_FILES))) \
		  $(OBJ_DIR)/$(ITEST).o

dtest:	$(DTEST_BIN)

regression_api:	$(REGAPI_BIN)

timer_regression:	$(TIMERREG_BIN)

play_analysis_benchmark:	$(PLAYREG_BIN)

alpha_mu:	$(ALPHAMU_BIN)

moves_sort_benchmark:	$(MOVESORTBENCH_BIN)

profile_binaries:
	$(MAKE) -f Makefiles/Makefile_Mac_clang PROFILE_BUILD=1 regression_api dtest play_analysis_benchmark alpha_mu

pgo_generate_binaries:
	$(MAKE) -f Makefiles/Makefile_Mac_clang PGO_MODE=generate regression_api dtest play_analysis_benchmark alpha_mu

pgo_use_binaries:
	$(MAKE) -f Makefiles/Makefile_Mac_clang PGO_MODE=use regression_api dtest play_analysis_benchmark alpha_mu

itest:	$(ITEST_BIN)

$(DTEST_BIN):	$(DTEST_OBJ_FILES)
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) $(LINK1_FLAGS) $(DTEST_OBJ_FILES) \
		$(LINK2_FLAGS) -o $@

$(REGAPI_BIN):	$(REGAPI_OBJ_FILES)
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) $(LINK1_FLAGS) $(REGAPI_OBJ_FILES) \
		$(LINK2_FLAGS) -o $@

$(TIMERREG_BIN):	$(TIMERREG_OBJ_FILES)
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) $(LINK1_FLAGS) $(TIMERREG_OBJ_FILES) \
		$(LINK3_FLAGS) -o $@

$(PLAYREG_BIN):	$(PLAYREG_OBJ_FILES)
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) $(LINK1_FLAGS) $(PLAYREG_OBJ_FILES) \
		$(LINK2_FLAGS) -o $@

$(ALPHAMU_BIN):	$(ALPHAMU_OBJ_FILES)
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) $(LINK1_FLAGS) $(ALPHAMU_OBJ_FILES) \
		$(LINK2_FLAGS) -o $@

$(MOVESORTBENCH_BIN):	$(MOVESORTBENCH_OBJ_FILES)
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) $(LINK1_FLAGS) $(MOVESORTBENCH_OBJ_FILES) \
		$(LINK2_FLAGS) -o $@

$(ITEST_BIN):	$(ITEST_OBJ_FILES)
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) $(LINK1_FLAGS) $(ITEST_OBJ_FILES) \
		$(LINK3_FLAGS) -o $@

$(OBJ_DIR)/%.o:	%.cpp
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

$(OBJ_DIR)/src/%.o:	../src/%.cpp
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

$(OBJ_DIR)/examples/%.o:	../examples/%.cpp
	@mkdir -p $(dir $@)
	$(CC) $(COMPILE_FLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

depend:
	@echo "Dependencies are generated automatically in $(OBJ_DIR)/*.d"

clean:
	rm -rf $(BUILD_DIR) *.o *.d $(DTEST) $(ITEST) $(REGAPI) $(TIMERREG) $(STATIC_LIB)

-include $(subst .o,.d,$(DTEST_OBJ_FILES))
-include $(subst .o,.d,$(REGAPI_OBJ_FILES))
-include $(subst .o,.d,$(TIMERREG_OBJ_FILES))
-include $(subst .o,.d,$(PLAYREG_OBJ_FILES))
-include $(subst .o,.d,$(ALPHAMU_OBJ_FILES))
-include $(subst .o,.d,$(MOVESORTBENCH_OBJ_FILES))
-include $(subst .o,.d,$(ITEST_OBJ_FILES))


$(OBJ_DIR)/%.o:	%.cpp
	@mkdir -p $(dir $@)
	$(CC) $(CC_FULL_FLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

depend:
	@echo "Dependencies are generated automatically in $(OBJ_DIR)/*.d"

clean:
	rm -rf $(BUILD_DIR) *.o $(STATIC_LIB) $(subst .cpp,,$(ALL_EXAMPLE_FILES))

-include $(subst .o,.d,$(OBJ_FILES))
-include $(subst .o,.d,$(EX_OBJ_FILES))

